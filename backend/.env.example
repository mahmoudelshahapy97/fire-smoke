# =============================================================================
# APPLICATION
# =============================================================================
APP_NAME="Fire & Smoke API"
APP_DESCRIPTION="Fire and smoke detection, alerting and incident triage"
APP_VERSION="1.0.0"
APP_API_PREFIX="/api/v1"
APP_HOST="0.0.0.0"
APP_PORT=8000
APP_DEBUG=true
ENVIRONMENT=development

PYTHONUNBUFFERED=1
PYTHONDONTWRITEBYTECODE=1

# =============================================================================
# CORS
# =============================================================================
# The console reaches the API through a same-origin proxy (Vite in dev, nginx
# in the container), so CORS is not normally involved. These cover the case of
# a browser pointed straight at the API host.
CORS_ORIGINS='["http://localhost:5173","http://localhost:8083","http://localhost:8004"]'
CORS_ALLOW_CREDENTIALS=true
CORS_ALLOW_METHODS='["GET","POST","PUT","PATCH","DELETE"]'
CORS_ALLOW_HEADERS='["Content-Type","Authorization","X-Request-ID"]'

# =============================================================================
# AUTH
# =============================================================================
# Required -- the app refuses to start without it. Generate with:
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
SECRET_KEY="generate-your-own-see-comment-above"
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=7

# Set true once served over HTTPS.
AUTH_COOKIE_NAME=fs_access
AUTH_COOKIE_SECURE=false
AUTH_COOKIE_SAMESITE=lax

# There is no public signup. This account is created once, when app_user is
# empty at startup. Change the password after first login.
BOOTSTRAP_ADMIN_USERNAME=admin
BOOTSTRAP_ADMIN_EMAIL=admin@firesmoke.local
BOOTSTRAP_ADMIN_PASSWORD=ChangeMe!123

# "Forgot your password?" mails a 6-digit code to the account's email. It is
# off (the link is hidden) until SMTP_HOST is set below.
OTP_TTL_SECONDS=600
OTP_RESEND_SECONDS=60
OTP_MAX_ATTEMPTS=5

# =============================================================================
# EMAIL (SMTP) -- password-reset codes and fire / smoke alert emails
# =============================================================================
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM="Fire & Smoke <no-reply@firesmoke.local>"
# STARTTLS on 587; set SMTP_SSL=true (and SMTP_STARTTLS=false) for port 465.
SMTP_STARTTLS=true
SMTP_SSL=false

# =============================================================================
# LOGGING
# =============================================================================
LOG_LEVEL=INFO
LOG_FORMAT="%(asctime)s - %(name)s - %(levelname)s - %(message)s"
LOG_FILE_PATH="logs/firesmoke.log"

# =============================================================================
# DATABASE (POSTGRES)
# =============================================================================
POSTGRES_DB="firesmoke_db"
POSTGRES_USER="firesmoke"
POSTGRES_PASSWORD="firesmoke_pass"
DB_HOST="db"
DB_PORT=5432

DB_MIN_POOL_SIZE=2
DB_MAX_POOL_SIZE=10
DB_TIMEOUT=30.0
DB_COMMAND_TIMEOUT=60.0
DB_MAX_RETRIES=10
DB_RETRY_DELAY_BASE=2
DB_RETRY_DELAY_MAX=30

# =============================================================================
# MODELS
# =============================================================================
YOLO_CONFIG_DIR="/app/.ultralytics"
MODEL_DEVICE=cuda

# InsightEye's fire & smoke detector (YOLO26n). Its classes are named "0",
# "1", "2"; FIRE_CLASS_MAP says which is which (InsightEye: 0 fire, 1 smoke,
# 2 ignored). See models/README.md.
FIRE_MODEL_PATH="models/fire.pt"
FIRE_INPUT_SIZE=640
FIRE_CLASS_MAP='{"0":"fire","1":"smoke"}'
# Confidence a box needs to count, per kind (InsightEye: 0.5)
FIRE_CONFIDENCE=0.5
SMOKE_CONFIDENCE=0.5
# FP16 on CUDA
FIRE_HALF=true

# =============================================================================
# RTSP / STREAM
# =============================================================================
RTSP_TRANSPORT=tcp
RTSP_BUFFER_SIZE=1
RTSP_OPEN_TIMEOUT=15.0
RTSP_READ_FAILURE_LIMIT=30
RTSP_RECONNECT_DELAY_BASE=2.0
RTSP_RECONNECT_DELAY_MAX=30.0

# Process 1 out of every N decoded frames
FRAME_SKIP=5
TARGET_PROCESS_FPS=5.0
JPEG_QUALITY=85

STREAM_START_STAGGER_DELAY=2.0
STREAM_WORKER_RESTART_DELAY=5.0

# Concurrent MJPEG live viewers across all cameras
MAX_MJPEG_CLIENTS=4

# =============================================================================
# WORKER SUPERVISION
# =============================================================================
# Restart dead, errored or stalled workers; start enabled cameras with no worker
WORKER_SUPERVISION_ENABLED=true
WORKER_SUPERVISION_INTERVAL_S=15.0
WORKER_RESTART_BACKOFF_BASE_S=5.0
WORKER_RESTART_BACKOFF_MAX_S=300.0

# =============================================================================
# EVIDENCE CLIPS
# =============================================================================
# Annotated mp4 per incident: CLIP_PRE_SECONDS before it is confirmed and
# CLIP_POST_SECONDS after. Kept under CLIP_DIR/<camera_id>/ only while MinIO is
# unreachable.
CLIP_ENABLED=true
CLIP_DIR="data/clips"
CLIP_PRE_SECONDS=20.0
CLIP_POST_SECONDS=20.0
CLIP_MAX_WIDTH=960
CLIP_JPEG_QUALITY=70

# =============================================================================
# RETENTION
# =============================================================================
RETENTION_ENABLED=true
RETENTION_INTERVAL_S=21600
CLIP_RETENTION_DAYS=30
CLIP_MAX_TOTAL_MB=5120

# =============================================================================
# FIRE / SMOKE INCIDENTS
# =============================================================================
# Detector runs per camera per second (frames are still read at
# TARGET_PROCESS_FPS for the live view and clips)
FIRE_DETECT_FPS=2.0
# A kind is confirmed when seen in FIRE_CONFIRM_HITS of the last
# FIRE_CONFIRM_WINDOW inferences; one flicker is not a fire
FIRE_CONFIRM_HITS=3
FIRE_CONFIRM_WINDOW=5
# The incident closes after this long without a sighting
FIRE_CLEAR_AFTER_S=30
# Seen again within this long of closing: the same incident reopens, no new
# alert (InsightEye's 10-minute cooldown)
FIRE_COOLDOWN_S=600
# Email the workspace's members when an incident opens (needs SMTP_HOST)
ALERT_EMAIL_ENABLED=true

# =============================================================================
# OBJECT STORAGE (MinIO)
# =============================================================================
# Images and videos go to MinIO; Postgres keeps the records and object keys.
# docker-compose sets these for the api from the root .env. Leave the endpoint
# empty to keep media in Postgres / on disk.
MINIO_ENDPOINT=
MINIO_ACCESS_KEY=
MINIO_SECRET_KEY=
MINIO_BUCKET=firesmoke
MINIO_SECURE=false
