# Read by docker-compose.yml (not by the api; that is backend/.env).
#   cp .env.example .env

# MinIO's root account. The api uses the same pair as MINIO_ACCESS_KEY /
# MINIO_SECRET_KEY. Required: compose refuses to start without them.
MINIO_ROOT_USER=firesmoke
MINIO_ROOT_PASSWORD=change-me-to-a-long-random-string
MINIO_BUCKET=firesmoke

# Host ports, if the defaults clash with something else on the machine.
# POSTGRES_HOST_PORT=5437
# API_HOST_PORT=8004
# WEB_HOST_PORT=8083
# RTSP_HOST_PORT=8557
# MINIO_API_HOST_PORT=9002
# MINIO_CONSOLE_HOST_PORT=9003
