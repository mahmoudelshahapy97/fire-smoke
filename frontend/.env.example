# Where the Vite dev server proxies /api and /health.
#
# The API's documented port is 8000, but docker-compose.yml publishes it on
# 8004 on this machine so the stack coexists with the other feature stacks.
# Point this at whichever one you are running.
VITE_API_TARGET=http://127.0.0.1:8004

# Dev-server port. The e2e suite and the README both assume 5173.
VITE_PORT=5173
VITE_PREVIEW_PORT=4173

# How often the console polls for unacknowledged fire / smoke alerts (ms).
VITE_ALERT_POLL_MS=3000
