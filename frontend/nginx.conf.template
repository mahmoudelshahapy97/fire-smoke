# Production counterpart of the Vite dev proxy in vite.config.js.
#
# Same contract: the browser only ever talks to this origin, nginx forwards
# /api, /health and FastAPI's own /docs to the API. Keep the two files in step --
# a path proxied in dev but not here is a 404 that only shows up after a build.
#
# Rendered by envsubst at container start (see the Dockerfile), so ${FS_API_URL}
# comes from the environment rather than being baked into the image.

server {
    listen       80;
    server_name  _;

    root  /usr/share/nginx/html;
    index index.html;

    proxy_http_version 1.1;
    # A cold API is still loading the detector; the first snapshot can take a while.
    proxy_read_timeout 300s;
    proxy_send_timeout 300s;

    # Nothing uploads large bodies today; kept above nginx's 1 MB default so a
    # long camera ROI or settings payload is never refused with a bare 413.
    client_max_body_size 12m;

    # The SPA owns its routes: /events/<uuid> is React Router's, not a file.
    # Security headers. add_header in a location replaces the server's, so the
    # two locations that set their own cache headers repeat these.
    add_header X-Content-Type-Options "nosniff" always;
    add_header X-Frame-Options "DENY" always;
    add_header Referrer-Policy "strict-origin-when-cross-origin" always;
    add_header Permissions-Policy "camera=(), microphone=(), geolocation=()" always;
    add_header Content-Security-Policy "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline' https://fonts.googleapis.com; font-src 'self' https://fonts.gstatic.com data:; img-src 'self' data: blob:; media-src 'self' blob:; connect-src 'self' ws: wss:; frame-ancestors 'none'; base-uri 'self'; object-src 'none'" always;

    location / {
        try_files $uri $uri/ /index.html;
    }

    # Hashed asset filenames: safe to cache hard. index.html must never be
    # cached, or a deploy leaves browsers pointing at assets that are gone.
    location /assets/ {
        expires 1y;
        add_header Cache-Control "public, immutable";
        add_header X-Content-Type-Options "nosniff" always;
        add_header X-Frame-Options "DENY" always;
        add_header Referrer-Policy "strict-origin-when-cross-origin" always;
    }

    location = /index.html {
        add_header Cache-Control "no-store";
        add_header X-Content-Type-Options "nosniff" always;
        add_header X-Frame-Options "DENY" always;
        add_header Referrer-Policy "strict-origin-when-cross-origin" always;
        add_header Permissions-Policy "camera=(), microphone=(), geolocation=()" always;
        add_header Content-Security-Policy "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline' https://fonts.googleapis.com; font-src 'self' https://fonts.gstatic.com data:; img-src 'self' data: blob:; media-src 'self' blob:; connect-src 'self' ws: wss:; frame-ancestors 'none'; base-uri 'self'; object-src 'none'" always;
    }

    # MJPEG live view: an endless multipart response. Buffered, nginx would
    # hold frames back until its buffer filled and the view would stutter.
    location ~ ^/api/v1/cameras/[^/]+/stream$ {
        proxy_pass        ${FS_API_URL};
        proxy_buffering   off;
        proxy_cache       off;
        proxy_read_timeout 1h;
        proxy_set_header  Host              $host;
        proxy_set_header  X-Real-IP         $remote_addr;
        proxy_set_header  X-Forwarded-For   $proxy_add_x_forwarded_for;
        proxy_set_header  X-Forwarded-Proto $scheme;
    }

    # Live notifications: a WebSocket, so the upgrade has to be passed on and
    # the connection kept open far past the usual read timeout.
    location = /api/v1/notifications/ws {
        proxy_pass         ${FS_API_URL};
        proxy_set_header   Upgrade           $http_upgrade;
        proxy_set_header   Connection        "upgrade";
        proxy_set_header   Host              $host;
        proxy_set_header   X-Forwarded-For   $proxy_add_x_forwarded_for;
        proxy_read_timeout 1h;
    }

    location /api/ {
        proxy_pass       ${FS_API_URL};
        proxy_set_header Host              $host;
        proxy_set_header X-Real-IP         $remote_addr;
        proxy_set_header X-Forwarded-For   $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
    }

    # The probe the health badge polls, mounted outside the versioned prefix.
    location /health {
        proxy_pass       ${FS_API_URL};
        proxy_set_header Host $host;
    }

    location /docs {
        proxy_pass       ${FS_API_URL};
        proxy_set_header Host $host;
    }

    location /redoc {
        proxy_pass       ${FS_API_URL};
        proxy_set_header Host $host;
    }

    location = /openapi.json {
        proxy_pass       ${FS_API_URL};
        proxy_set_header Host $host;
    }

    gzip              on;
    gzip_types        text/css application/javascript application/json image/svg+xml;
    gzip_min_length   1024;
}
